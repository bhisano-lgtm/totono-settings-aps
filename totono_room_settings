    rule: custom
    value-name: 部屋ID

  - key: "部屋名"
    rule: direct
    value-name: 部屋番号

  - key: "建物コード"
    rule: direct
    value-name: 建物ID

  - key: "階"
    rule: direct
    value-name: 所属階

  - key: "間取"
    rule: direct
    value-name: 間取り名

  - key: "間取コード"
