    value-name: 間取りCD

  - key: "専有面積"
    rule: direct
    value-name: 専有面積（㎡）

  - key: "部屋用途名"
    rule: automatic-pair
    code-name: 種別CD
    value-name: 種別名

  - key: "部屋用途名"
    rule: conditional
    code-name: システム区分
    value-name:
    pattern:
      - case: その他
        operand: "="
        then:
          code: 0
          value: 指定なし
      - case: 事務所
        operand: "="
        then:
          code: 2
          value: 事業
      - case: 住居
        operand: "="
        then:
          code: 1
          value: 住居
      - case: 特殊物件
        operand: "="
        then:
          code: 0
          value: 指定なし
      - case: 店舗
        operand: "="
        then:
          code: 2
          value: 事業
      - else:
          code: 0
          value:

