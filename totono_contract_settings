calculation:
  - key: "賃貸借契約NO"
    rule: concat
    value-name: 契約ID
    value: ${賃貸借契約NO}R${入居者CD}

  - key: "部屋CD"
    rule: custom
    value-name: 部屋ID

  - key: "契約者CD"
    rule: direct
    value-name: 契約者　顧客ID

  - key: "契約者名"
    rule: direct
    value-name: 契約者　顧客名

  - key: "入居者CD"
    rule: direct
    value-name: 入居者　顧客ID

  - key: "入居者名"
    rule: direct
    value-name: 入居者　顧客名

  - key: "入居者_続柄"
    rule: automatic-pair
    code-name: 入居者　続柄CD
    value-name: 入居者　続柄名

  - key: "連帯保証人1_続柄"
    rule: automatic-pair
    code-name: 保証人1　続柄CD
    value-name: 保証人1　続柄名

  - key: "連帯保証人2_続柄"
    rule: automatic-pair
    code-name: 保証人2　続柄CD
    value-name: 保証人2　続柄名

  - key: "賃借ステータス名"
    rule: conditional
    code-name: 契約状況
    value-name: 契約状況名
    pattern:
      - case: 契約処理中
        operand: "="
        then:
          code: 1
          value: 申込
      - case: 申込キャンセル
        operand: "="
        then:
          code: 99
          value: キャンセル
      - case: 入居中
        operand: "="
        then:
          code: 2
          value: 契約中
      - case: 更新処理中
        operand: "="
        then:
          code: 2
          value: 契約中
      - case: 更新処理中(更新キャンセル)
        operand: "="
        then:
          code: 2
          value: 契約中
      - case: 更新キャンセル
        operand: "="
        then:
          code: 2
          value: 契約中
      - case: 退去処理中(更新キャンセル)
        operand: "="
        then:
          code: 2
          value: 契約中
      - case: 退去処理中
        operand: "="
        then:
          code: 3
          value: 解約予定
      - case: 解約済
        operand: "="
        then:
          code: 4
          value: 解約完了
      - case: 解約済(更新キャンセル)
        operand: "="
        then:
          code: 4
          value: 解約完了
      - case: 管理対象外(申込キャンセル)
        operand: "="
        then:
          code: 0
          value: 未設定
      - case: 管理対象外(入居中)
        operand: "="
        then:
          code: 0
          value: 未設定
      - case: 管理対象外(更新キャンセル)
        operand: "="
        then:
          code: 0
          value: 未設定
      - case: 管理対象外(解約済)
        operand: "="
        then:
          code: 0
          value: 未設定
      - case: 管理対象外(解約済(更新キャンセル))
        operand: "="
        then:
          code: 0
          value: 未設定
      - case: 管理対象外(解約済(期間満了))
        operand: "="
        then:
          code: 0
          value: 未設定
      - case: 管理対象外(期間満了)
        operand: "="
        then:
          code: 0
          value: 未設定
      - else:
          code: 0
          value: 未設定

  - key: "初回契約開始日"
    rule: custom
    value-name: 契約日

  - key: "初回契約開始日"
    rule: custom
    value-name: 入居日

  - key: "契約開始日"
    rule: custom
    value-name: 契約開始日

  - key: "契約終了日"
    rule: custom
    value-name: 契約終了日

  - key: "自動更新区分名"
    rule: conditional
    code-name: 自動更新フラグ
    value-name:
    pattern:
      - case: あり
        operand: "="
        then:
          code: 1
          value: 対象
      - case: なし
        operand: "="
        then:
          code: 0
          value: 対象外
      - else:
          code: 0
          value: 対象外

  - key: "退去申出期限区分"
    rule: conditional
    code-name: 退去予告日区分
    value-name:
    pattern:
      - case: 2
        operand: "="
        then:
          code: 1
          value:
      - else:
          code: 0
          value:

  - key: "退去申出期限区分名"
    rule: direct
    value-name: 退去予告日区分名

  - key: "退去申出期限月数"
    rule: direct
    value-name: 退去予告日

  - key: "保証会社名"
    rule: direct
    value-name: 保証契約　保証会社　顧客名

